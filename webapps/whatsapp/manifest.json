{
  "manifest_version": 3,
  "name": "WhatsApp Slim — SolarOS",
  "version": "1.1.41",
  "key": "",
  "description": "Omarchy WhatsApp Slim with a non-invasive SolarOS accent layer.",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "whatsapp.css",
        "solaros-base.css"
      ],
      "js": [
        "system-theme.js",
        "theme-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "active.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
