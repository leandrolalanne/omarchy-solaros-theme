#!/usr/bin/env bash

set -euo pipefail

# Always re-read the state file instead of trusting $1: omarchy-theme-set
# only serializes its fast staging step, not the hook chain, so switching
# themes twice in quick succession runs two theme-set hook chains in
# parallel and they can finish out of order (see ayaka-smoky for the fuller
# writeup — same bug, same fix). Reading the file fresh means every hook
# instance, no matter when it finishes, applies whatever theme is actually
# current right now, instead of the stale slug it was launched with.
theme_slug=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
[[ ${theme_slug,,} == "solaros" ]] || exit 0

# Otros temas reescriben las decoraciones de Hyprland globalmente cuando se
# activan (ayaka-smoky, por ejemplo, apaga el blur para todo tema que no sea
# Ayaka). SolarOS corre despues y vuelve a poner sus propios valores.
#
# Estos valores deben seguir a themes/solaros/hyprland.lua: opacidad 0.88
# pareja y sin difuminado.
hyprctl eval 'hl.config({
  decoration = {
    active_opacity = 0.88,
    inactive_opacity = 0.88,
    blur = {
      enabled = false,
    },
  },
})' >/dev/null
