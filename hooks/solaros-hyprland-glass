#!/usr/bin/env bash

set -euo pipefail

# Always re-read the state file instead of trusting $1: omarchy-theme-set
# only serializes its fast staging step, not the hook chain, so switching
# themes twice in quick succession runs two theme-set hook chains in
# parallel and they can finish out of order (see ayaka-smoky for the fuller
# writeup — same bug, same fix). Reading the file fresh means every hook
# instance, no matter when it finishes, applies whatever theme is actually
# current right now, instead of the stale slug it was launched with.
theme_slug=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
[[ $theme_slug == "solaros" ]] || exit 0

# ayaka-smoky intentionally disables blur for every non-Ayaka theme after the
# theme's Hyprland module is loaded. SolarOS runs later and restores its own
# theme-scoped opacity values after a theme switch or desktop boot.
#
# Estos valores deben seguir a themes/solaros/hyprland.lua: blur desactivado y
# opacidad 0.88 pareja.
hyprctl eval 'hl.config({
  decoration = {
    active_opacity = 0.88,
    inactive_opacity = 0.88,
    blur = {
      enabled = false,
      size = 8,
      passes = 2,
      noise = 0,
      contrast = 1.0,
      brightness = 1.0,
      vibrancy = 0.1,
      vibrancy_darkness = 0,
      ignore_opacity = true,
      new_optimizations = true,
      xray = false,
      special = true,
      popups = true,
      popups_ignorealpha = 0.15,
      input_methods = true,
      input_methods_ignorealpha = 0.15,
    },
  },
})' >/dev/null
